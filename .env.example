# HTTP port for the local MCP server foundation.
PORT=3000
HTTP_HOST=127.0.0.1

# Required when binding to a non-loopback host. Hostnames only; omit ports.
# HTTP_ALLOWED_HOSTS=story-keeper.example.com

# Optional browser-origin allowlist. Requests without Origin remain valid for MCP clients.
# HTTP_ALLOWED_ORIGINS=https://story-keeper.example.com

# Local SQLite path. Parent directories are created automatically.
DATABASE_PATH=./data/story-keeper.sqlite

# Extraction is disabled by default so local development and tests never call AWS.
STORY_EXTRACTION_PROVIDER=disabled
CHAPTER_GENERATION_PROVIDER=disabled
WORKER_POLL_INTERVAL_MS=1000
WORKER_LOCK_TIMEOUT_MS=60000
JOB_RETRY_DELAY_MS=5000
JOB_MAX_ATTEMPTS=3

# Required only when STORY_EXTRACTION_PROVIDER=bedrock. Credentials use the normal AWS provider chain.
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=your-enabled-model-or-inference-profile-id
BEDROCK_TEMPERATURE=0
BEDROCK_MAX_TOKENS=2048
BEDROCK_CHAPTER_TEMPERATURE=0.2
BEDROCK_CHAPTER_MAX_TOKENS=4096
BEDROCK_TIMEOUT_MS=30000
BEDROCK_SDK_MAX_ATTEMPTS=3

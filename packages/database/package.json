{
  "name": "@story-keeper/database",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --conditions=development --import tsx src/migrate-cli.ts",
    "db:seed": "node --conditions=development --import tsx src/seed-cli.ts"
  },
  "dependencies": {
    "@story-keeper/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.7"
  }
}

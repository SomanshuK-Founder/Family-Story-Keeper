{
  "name": "family-story-keeper",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10"
  },
  "scripts": {
    "build": "tsc -b --clean && tsc -b",
    "db:migrate": "node --conditions=development --env-file-if-exists=.env --import tsx packages/database/src/migrate-cli.ts",
    "db:seed": "node --conditions=development --env-file-if-exists=.env --import tsx packages/database/src/seed-cli.ts",
    "dev": "node --conditions=development --env-file-if-exists=.env --import tsx packages/mcp-server/src/index.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "search:rebuild": "node --conditions=development --env-file-if-exists=.env --import tsx packages/database/src/search-rebuild-cli.ts",
    "demo:smoke": "vitest run packages/mcp-server/test/backend-journey.e2e.test.ts",
    "test:performance": "node --conditions=development --import tsx packages/mcp-server/test/performance-smoke.ts",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false && tsc -p tsconfig.tests.json --pretty false"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.12.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.46.1",
    "vitest": "^5.0.3"
  }
}
